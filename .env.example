NODE_ENV=production
PORT=3000
DATA_BACKEND=sqlite
MANUAL_STORAGE=local
DATA_DIR=/app/data
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
PUBLIC_ORIGIN=https://supercardocs.com
APP_ORIGIN=https://app.supercardocs.com
RECOVERY_DB_PATH=/app/private-data/recovery-source.db
MANUALS_DIR=/app/manuals
MANUAL_BUNDLE_PATH=/app/private-data/manuals.bundle
MANUAL_INDEX_PATH=/app/private-data/manuals-index.json
STARTUP_LOG_FILE=/app/private-data/startup-error.log

# Optional public-guide automation. Keep both secrets server-side and rotate any key pasted into chat.
SEO_AUTOPUBLISH_ENABLED=false
DEEPSEEK_API_KEY=replace-with-a-server-only-deepseek-key
SEO_AUTOMATION_SECRET=replace-with-a-long-random-cron-secret

# Hostinger MySQL: use DATA_BACKEND=mysql after the one-time migration passes.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=replace-with-hostinger-database-user
MYSQL_PASSWORD=replace-with-hostinger-database-password
MYSQL_DATABASE=replace-with-hostinger-database-name
MYSQL_MIGRATION_PATH=/app/data/kks-repair.db

# Hostinger managed Node.js only: private HTTP bridge to public_html/private-data.
# Configure both together and use a long random server-only token.
MANUAL_REMOTE_BASE_URL=https://example.com/private-data/
MANUAL_REMOTE_TOKEN=replace-with-a-long-random-token

# Required only for Supabase migration or when DATA_BACKEND/MANUAL_STORAGE is supabase.
# These values are server-only. Never expose SUPABASE_SECRET_KEY to browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-me
SUPABASE_EXPECTED_PROJECT_REF=your-project-ref
SUPABASE_MANUAL_BUCKET=manuals
SQLITE_MIGRATION_PATH=/app/data/kks-repair.db
SUPABASE_MANUAL_UPLOAD_STATE=/app/data/supabase-manual-upload.jsonl
